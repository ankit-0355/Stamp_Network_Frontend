    "@angular/router": "^21.2.18",
    "ngx-cookie-service": "^21.3.1",
    "ngx-skeleton-loader": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
